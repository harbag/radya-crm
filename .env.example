# Radya CRM — required environment variables
# Copy to `.env.local` for local dev, and set these in your host
# (e.g. Vercel → Settings → Environment Variables) for deployments.
#
# Find both values in Supabase → Project Settings → API.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
